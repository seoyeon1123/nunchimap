# ─────────────────────────────────────────────
# 눈치맵 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 값 채워서 사용
# ─────────────────────────────────────────────

# Supabase (https://supabase.com 프로젝트 생성 후 Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 디벨로퍼스 (https://developers.kakao.com 일반 앱 등록)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# LOCALDATA (https://www.localdata.go.kr 인증키 신청 → 마이페이지)
LOCALDATA_API_KEY=

# VWorld 지오코더 (https://www.vworld.kr 오픈API 인증키 신청)
# → 주소를 WGS84 좌표로 직접 변환. juso.go.kr 보다 우리 케이스에 적합.
JUSO_API_KEY=

# 네이버 클로바 OCR (Phase 5에서 사용, 지금은 비워둬도 됨)
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# JWT (앱 내부용, 임의의 긴 문자열)
JWT_SECRET=
